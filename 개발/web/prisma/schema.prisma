// Life OS.ONE — Prisma 스키마
// 단일 진실 공급원: 노션 API 명세 v1
// SQLite 로컬 개발용. 프로덕션 Postgres 이전 시 provider만 교체하고
// JSON-as-String 컬럼들은 String[] 로 마이그레이션.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// User · Profile
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER") // USER | MERCHANT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      Profile?
  merchantId   String?  @unique
  merchant     Merchant? @relation(fields: [merchantId], references: [id])
  reservations Reservation[]
}

// 회원가입 7단계 중 1단계(account)는 User에, 2~7단계는 Profile에 저장.
// 태그류는 SQLite array 미지원으로 JSON 문자열 (예: '["cholesterol","fatigue"]').
// 건너뛰기 시 기본값 "[]" 또는 null 유지.
model Profile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 단일 선택
  shapeKey      String?  // gain | diet | bulk | never-ending-dieter | maintain
  jobKey        String?  // student | employee | medical | freelancer | parent | senior | etc

  // 다중 선택 (JSON-as-String)
  healthTags    String   @default("[]") // cholesterol | hypertension | blood-sugar | fatigue | joints | healthy
  dietTags      String   @default("[]") // vegetarian | vegan | pesco | halal | omnivore
  allergyTags   String   @default("[]") // nuts | shellfish | lactose
  lifestyleTags String   @default("[]") // caffeine | alcohol | night-owl | early-bird
  interests     String   @default("[]") // economy | entertainment | sports | it | health | fashion | self-dev | parenting | food | travel

  // 위치 (선택)
  addressLat    Float?
  addressLng    Float?

  updatedAt     DateTime @updatedAt
}

// ============================================================
// Merchant · Menu (노션 fetch → seed)
// ============================================================

model Merchant {
  id            String   @id @default(cuid())
  name          String
  category      String   // 한식 | 일식 | 중식 | 양식 | 카페·디저트 | 분식 | 술집·바 | 기타
  address       String
  lat           Float?
  lng           Float?
  businessHours String?  // 예: "11:00 ~ 21:00 (브레이크 15:00~17:00)"
  phone         String?
  description   String?
  thumbnail     String?  // 이미지 URL (선택)
  tags          String   @default("[]") // 저염 | 단백질 강조 | 글루텐프리 등
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menus         Menu[]
  users         User[]   // 가맹점 운영자 계정
  reservations  Reservation[]
}

model Menu {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name         String
  price        Int      // 원 단위
  kcal         Int?
  proteinG     Float?
  prepMinutes  Int?
  description  String?
  dietTags     String   @default("[]") // 고단백 | 저염 | 채식 등
  allergens    String   @default("[]") // 글루텐 | 견과 | 유당 등
  isSignature  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  reservations Reservation[]
}

// ============================================================
// Reservation (예약)
// ============================================================

model Reservation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id])
  menuId          String?
  menu            Menu?    @relation(fields: [menuId], references: [id])

  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  reservationTime DateTime
  partySize       Int      @default(1)
  note            String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([merchantId])
  @@index([status])
}
